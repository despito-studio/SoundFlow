// Shared native controls. All interactive elements expose keyboard and Windows
// accessibility actions; the monochrome palette is independent of OS accents.
export global Theme {
    in-out property <bool> dark: false;
    in-out property <bool> reduced-motion: false;
    in-out property <bool> modal-open: false;
    out property <color> canvas: dark ? #161616 : #fafaf9;
    out property <color> sidebar: dark ? #1d1d1d : #f0f0ee;
    out property <color> surface: dark ? #242424 : #ffffff;
    out property <color> raised: dark ? #2d2d2d : #f4f4f2;
    out property <color> hover: dark ? #363636 : #eaeae7;
    out property <color> ink: dark ? #f7f7f5 : #191919;
    out property <color> muted: dark ? #b8b8b3 : #62625d;
    out property <color> line: dark ? #41413f : #deded9;
    // Interactive boundaries need greater contrast than decorative separators.
    out property <color> control-line: dark ? #8c8c86 : #8a8a84;
    out property <color> inverse: dark ? #161616 : #ffffff;
    out property <color> danger: dark ? #f4aaa2 : #9d2b21;
}

export component SFButton inherits Rectangle {
    in property <string> text;
    in property <string> label: text;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> checkable: false;
    in property <bool> checked: active;
    in property <bool> flat: false;
    in property <bool> enabled: true;
    in property <bool> modal-control: false;
    in property <bool> icon: false;
    in property <bool> danger: false;
    in property <bool> left-align: false;
    callback clicked();
    out property <bool> has-focus: button-focus.has-focus;
    private property <bool> interactive: enabled && (!Theme.modal-open || modal-control);
    min-height: 40px;
    preferred-height: 40px;
    max-height: 40px;
    min-width: icon ? 40px : 64px;
    preferred-width: icon ? 40px : max(80px, caption.preferred-width + 28px);
    max-width: icon ? 40px : 100000px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: icon ? 20px : 12px;
    background: primary ? Theme.ink : active ? Theme.hover : touch.has-hover ? Theme.hover : flat ? transparent : Theme.raised;
    border-width: 0px;
    opacity: interactive ? 1 : 0.45;
    forward-focus: button-focus;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: interactive;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { if root.interactive { root.clicked(); } }
    animate background { duration: Theme.reduced-motion ? 0ms : 100ms; }
    Rectangle {
        x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px;
        border-radius: parent.border-radius + 4px;
        border-width: 2px; border-color: Theme.ink; background: transparent;
        visible: button-focus.has-focus;
    }
    caption := Text {
        x: root.icon ? 0px : 14px;
        width: root.icon ? parent.width : parent.width - 28px;
        text: root.text;
        color: root.primary ? Theme.inverse : root.danger ? Theme.danger : Theme.ink;
        font-size: root.icon ? 20px : 13px;
        font-family: root.icon ? "Segoe UI Symbol" : "Segoe UI";
        font-weight: root.primary || root.active ? 600 : 500;
        horizontal-alignment: root.left-align ? left : center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    button-focus := FocusScope {
        enabled: root.interactive;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { button-focus.focus(); root.clicked(); }
    }
}

export component SFField inherits Rectangle {
    in-out property <string> text;
    in property <string> label;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in property <bool> modal-control: false;
    callback accepted(string);
    callback edited(string);
    in property <int> focus-request;
    out property <bool> has-focus: input.has-focus;
    public function select-all() { input.select-all(); }
    private property <bool> interactive: enabled && (!Theme.modal-open || modal-control);
    min-width: 80px;
    min-height: 42px;
    horizontal-stretch: 1;
    preferred-height: 42px;
    border-radius: 12px;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.ink : root.interactive ? Theme.control-line : Theme.line;
    background: Theme.surface;
    forward-focus: input;
    opacity: interactive ? 1 : 0.5;
    init => { if root.input-type == InputType.search || root.modal-control { input.focus(); } }
    changed focus-request => { if root.interactive { input.focus(); } }
    Rectangle {
        x: 13px; y: 2px;
        width: parent.width - 26px;
        height: parent.height - 4px;
        clip: true;
        Text {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            visible: root.text == "";
            text: root.placeholder;
            font-size: 14px;
            color: Theme.muted;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        input := TextInput {
            visible: root.interactive;
            text <=> root.text;
            width: max(parent.width, self.preferred-width);
            height: parent.height;
            font-size: 14px;
            color: Theme.ink;
            selection-background-color: Theme.ink;
            selection-foreground-color: Theme.inverse;
            single-line: true;
            vertical-alignment: center;
            input-type: root.input-type;
            read-only: !root.interactive;
            accessible-label: root.label;
            accessible-placeholder-text: root.placeholder;
            accessible-enabled: root.interactive;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
            cursor-position-changed(position) => {
                if position.x + self.x < 2px {
                    self.x = -position.x + 2px;
                } else if position.x + self.x > parent.width - 3px {
                    self.x = parent.width - position.x - 3px;
                }
            }
        }
    }
}

export component SFSlider inherits Rectangle {
    in property <float> value: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    in property <string> label;
    in property <bool> enabled: true;
    callback changed(float);
    callback released(float);
    private property <float> fraction: maximum > 0 ? min(1, max(0, (touch.pressed ? drag-value : value) / maximum)) : 0;
    private property <float> drag-value: value;
    private property <bool> interactive: enabled && !Theme.modal-open && maximum > 0;
    min-height: 24px;
    preferred-height: 28px;
    min-width: 52px;
    forward-focus: focus;
    accessible-role: slider;
    accessible-label: label;
    accessible-enabled: interactive;
    accessible-value: "" + value;
    accessible-value-minimum: 0;
    accessible-value-maximum: maximum;
    accessible-value-step: step;
    accessible-action-increment => { if root.interactive { root.changed(min(root.maximum, root.value + root.step)); root.released(min(root.maximum, root.value + root.step)); } }
    accessible-action-decrement => { if root.interactive { root.changed(max(0, root.value - root.step)); root.released(max(0, root.value - root.step)); } }
    accessible-action-set-value(v) => { if root.interactive { root.changed(min(root.maximum, max(0, v.to-float()))); root.released(min(root.maximum, max(0, v.to-float()))); } }
    Rectangle {
        x: 6px; y: (parent.height - 4px) / 2;
        width: parent.width - 12px; height: 4px;
        border-radius: 2px;
        background: root.interactive ? Theme.control-line : Theme.line;
        Rectangle { x: 0px; y: 0px; width: parent.width * root.fraction; height: parent.height; border-radius: 2px; background: Theme.ink; }
    }
    Rectangle {
        x: 2px + (parent.width - 12px) * root.fraction;
        y: (parent.height - 12px) / 2;
        width: 12px; height: 12px;
        border-radius: 6px;
        background: Theme.surface;
        border-color: Theme.ink;
        border-width: focus.has-focus ? 2px : 1px;
        visible: root.interactive;
    }
    focus := FocusScope {
        enabled: root.interactive;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.changed(max(0, root.value - root.step)); root.released(max(0, root.value - root.step)); return accept;
            }
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.changed(min(root.maximum, root.value + root.step)); root.released(min(root.maximum, root.value + root.step)); return accept;
            }
            if event.text == Key.Home { root.changed(0); root.released(0); return accept; }
            if event.text == Key.End { root.changed(root.maximum); root.released(root.maximum); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                focus.focus();
                root.drag-value = min(root.maximum, max(0, (self.mouse-x - 6px) / (self.width - 12px) * root.maximum));
            }
            if event.kind == PointerEventKind.up { root.released(root.drag-value); }
        }
        moved => {
            if self.pressed {
                root.drag-value = min(root.maximum, max(0, (self.mouse-x - 6px) / (self.width - 12px) * root.maximum));
                root.changed(root.drag-value);
            }
        }
        clicked => { root.changed(root.drag-value); }
    }
}

export component SFPanel inherits Rectangle {
    background: Theme.surface;
    border-radius: 20px;
    border-width: 1px;
    border-color: Theme.line;
    @children
}

export component SFCover inherits Rectangle {
    in property <image> artwork;
    in property <bool> round: false;
    border-radius: round ? min(self.width, self.height) / 2 : 12px;
    background: Theme.raised;
    clip: true;
    Image { width: parent.width; height: parent.height; source: root.artwork; image-fit: cover; accessible-role: none; }
    Text {
        visible: root.artwork.width == 0;
        text: "♫"; font-family: "Segoe UI Symbol"; font-size: min(34px, parent.width * 0.4);
        color: Theme.muted; horizontal-alignment: center; vertical-alignment: center;
        accessible-role: none;
    }
}

export component SFTitle inherits Text {
    horizontal-stretch: 1;
    font-size: 28px;
    font-weight: 700;
    color: Theme.ink;
    overflow: elide;
}

export component SFText inherits Text {
    horizontal-stretch: 1;
    font-size: 14px;
    color: Theme.ink;
    overflow: elide;
}

export component SFMuted inherits Text {
    horizontal-stretch: 1;
    font-size: 13px;
    color: Theme.muted;
    overflow: elide;
}

export component SFLangSwitch inherits Rectangle {
    in-out property <string> language: "uk";
    in property <bool> enabled: true;
    in property <bool> modal-control: false;
    callback language-changed(string);

    private property <bool> interactive: enabled && (!Theme.modal-open || modal-control);
    private property <bool> is-uk: language != "en";

    min-height: 34px;
    preferred-height: 34px;
    max-height: 36px;
    min-width: 86px;
    preferred-width: 86px;
    max-width: 96px;
    border-radius: 10px;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line;
    clip: false;

    accessible-role: button;
    accessible-label: root.is-uk ? "Мова: Українська" : "Language: English";
    accessible-action-default => {
        if root.interactive {
            if root.is-uk {
                root.language = "en";
                root.language-changed("en");
            } else {
                root.language = "uk";
                root.language-changed("uk");
            }
        }
    }

    focus-scope := FocusScope {
        enabled: root.interactive;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                if root.is-uk {
                    root.language = "en";
                    root.language-changed("en");
                } else {
                    root.language = "uk";
                    root.language-changed("uk");
                }
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px;
        border-radius: parent.border-radius + 2px;
        border-width: 2px; border-color: Theme.ink; background: transparent;
        visible: focus-scope.has-focus;
    }

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        Rectangle {
            horizontal-stretch: 1;
            border-radius: 7px;
            background: root.is-uk ? Theme.surface : (ua-touch.has-hover ? Theme.hover : transparent);
            border-width: root.is-uk ? 1px : 0px;
            border-color: root.is-uk ? Theme.control-line : transparent;
            drop-shadow-blur: root.is-uk ? 4px : 0px;
            drop-shadow-offset-y: root.is-uk ? 1px : 0px;
            drop-shadow-color: #00000014;
            animate background { duration: Theme.reduced-motion ? 0ms : 100ms; }

            Text {
                width: parent.width;
                height: parent.height;
                text: "UA";
                color: root.is-uk ? Theme.ink : Theme.muted;
                font-size: 12px;
                font-weight: root.is-uk ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            ua-touch := TouchArea {
                enabled: root.interactive;
                mouse-cursor: pointer;
                clicked => {
                    focus-scope.focus();
                    if !root.is-uk {
                        root.language = "uk";
                        root.language-changed("uk");
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            border-radius: 7px;
            background: !root.is-uk ? Theme.surface : (en-touch.has-hover ? Theme.hover : transparent);
            border-width: !root.is-uk ? 1px : 0px;
            border-color: !root.is-uk ? Theme.control-line : transparent;
            drop-shadow-blur: !root.is-uk ? 4px : 0px;
            drop-shadow-offset-y: !root.is-uk ? 1px : 0px;
            drop-shadow-color: #00000014;
            animate background { duration: Theme.reduced-motion ? 0ms : 100ms; }

            Text {
                width: parent.width;
                height: parent.height;
                text: "EN";
                color: !root.is-uk ? Theme.ink : Theme.muted;
                font-size: 12px;
                font-weight: !root.is-uk ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            en-touch := TouchArea {
                enabled: root.interactive;
                mouse-cursor: pointer;
                clicked => {
                    focus-scope.focus();
                    if root.is-uk {
                        root.language = "en";
                        root.language-changed("en");
                    }
                }
            }
        }
    }
}

