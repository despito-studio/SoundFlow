import { ScrollView, ListView, AboutSlint, Palette } from "std-widgets.slint";
import { TrackRow, PlaylistRow, DownloadRow, RankRow, StatMetric, DailyRow, AccountRow, CommandRow } from "models.slint";
export { TrackRow, PlaylistRow, DownloadRow, RankRow, StatMetric, DailyRow, AccountRow } from "models.slint";
import { Theme, SFButton, SFField, SFSlider, SFPanel, SFCover, SFTitle, SFText, SFMuted, SFLangSwitch, SFAccentDot, SFSkeleton } from "controls.slint";
import { TrackItem } from "track-item.slint";
import { HomeView } from "home.slint";
import { I18n } from "i18n.slint";
export { I18n } from "i18n.slint";
export { SoundFlowTray } from "tray.slint";

export component AppWindow inherits Window {
    title: "SoundFlow";
    icon: @image-url("../resources/icon.png");
    preferred-width: 1100px; preferred-height: 680px;
    min-width: 840px; min-height: 560px;
    background: Theme.canvas;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    in-out property <string> language: "uk";
    in-out property <string> view: "home";
    in-out property <[TrackRow]> tracks;
    in-out property <[PlaylistRow]> playlists;
    in-out property <[DownloadRow]> downloads;
    in-out property <[RankRow]> artists;
    in-out property <[RankRow]> top-tracks;
    in-out property <[RankRow]> providers;
    in-out property <[StatMetric]> metrics;
    in-out property <[DailyRow]> daily;
    in-out property <bool> task-loading;
    in-out property <string> message;
    in-out property <bool> message-error: false;
    in-out property <string> app-version: "";
    in-out property <string> update-version: "";
    in-out property <string> update-url: "";
    in-out property <bool> import-prompt-disabled: false;
    in-out property <bool> dark;
    in-out property <bool> reduced-motion;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> media-hotkeys: true;
    in-out property <string> profile-name: "Слухач";
    in-out property <bool> cloud-configured;
    in-out property <bool> supabase-linked: false;
    in-out property <string> accent: "mono";
    in-out property <color> player-accent: transparent;
    in-out property <bool> command-open: false;
    in-out property <string> command-query: "";
    in-out property <string> smart-kind: "recent";
    in-out property <[CommandRow]> commands;
    in-out property <bool> cloud-signed-in;
    in-out property <string> cloud-name;
    in-out property <string> cloud-email;
    in-out property <string> cloud-url;
    in-out property <bool> subscription-active;
    in-out property <string> subscription-message;
    in-out property <[AccountRow]> accounts;
    in-out property <TrackRow> current-track;
    in-out property <bool> playing;
    in-out property <bool> loading;
    in-out property <float> position;
    in-out property <float> duration;
    in-out property <float> volume: 0.75;
    in-out property <bool> shuffle;
    in-out property <string> repeat-mode: "off";
    in-out property <TrackRow> flow-track;
    in-out property <int> flow-index;
    in-out property <int> flow-count;
    in-out property <bool> flow-playing;
    in-out property <float> flow-progress;
    in-out property <string> flow-genre: "lofi";
    in-out property <string> search-query;
    in-out property <string> search-source: "all";
    in-out property <[string]> search-history;
    in-out property <string> modal-kind;
    in-out property <string> modal-title;
    in-out property <string> modal-description;
    in-out property <string> modal-value;
    in-out property <string> modal-error;
    in-out property <bool> modal-open;
    in-out property <bool> modal-busy;
    in-out property <[TrackRow]> match-tracks;
    in-out property <bool> yt-found: false;
    in-out property <string> yt-account: "";
    in-out property <bool> sc-found: false;
    in-out property <string> sc-account: "";
    in-out property <bool> sp-found: false;
    in-out property <string> sp-account: "";
    in-out property <string> accounts-import-status: "";
    in-out property <bool> infinite-autoplay: true;
    in-out property <bool> discord-rpc: true;
    in-out property <bool> show-onboarding: false;

    callback navigate(string);
    callback search(string, string);
    callback select-playlist(string);
    callback play-track(string);
    callback like-track(string);
    callback add-track(string);
    callback download-track(string);
    callback flow-action(string);
    callback player-action(string);
    callback seek(float);
    callback set-volume(float);
    callback action(string, string);
    callback modal-submit(string);
    callback modal-action(string, string);
    callback sign-in(string, string);
    callback sign-up(string, string, string);
    callback configure-cloud(string);
    callback sync-library(string);
    callback sign-out();
    callback google-sign-in();
    callback github-sign-in();
    callback connect-account(string, string);
    callback import-account(string);
    callback import-all-accounts(string);

    private property <length> side-width: root.width < 1000px ? 170px : 188px;
    private property <length> workspace-width: root.width - side-width;
    private property <length> content-inset: root.width < 1000px ? 16px : 24px;
    private property <string> download-url;
    private property <string> edited-name;
    private property <string> auth-name;
    private property <string> auth-email;
    private property <string> auth-password;
    private property <bool> register-mode;
    private property <string> server-url;
    private property <string> stats-period: "30d";
    private property <string> stats-source: "all";
    private property <bool> player-options;
    private property <bool> app-menu;
    private property <int> search-focus-request;
    init => {
        Theme.dark = root.dark; Theme.reduced-motion = root.reduced-motion; Theme.modal-open = root.modal-open;
        Theme.accent = root.accent;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
        I18n.locale = root.language;
    }
    changed language => { I18n.locale = root.language; }
    changed dark => { Theme.dark = root.dark; Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed reduced-motion => { Theme.reduced-motion = root.reduced-motion; }
    changed accent => { Theme.accent = root.accent; }
    changed current-track => { if !Theme.reduced-motion { player.track-fading = true; } }
    changed modal-open => { Theme.modal-open = root.modal-open; if !root.modal-open { app-focus.focus(); } }
    forward-focus: app-focus;

    // Тост із повідомленням автоматично зникає через 3 секунди після появи.
    toast-timer := Timer {
        // Помилки тримаємо довше, ніж звичайні повідомлення.
        interval: root.message-error ? 7s : 3s;
        running: false;
        triggered() => { root.message = ""; }
    }
    changed message => {
        toast-timer.running = false;
        if root.message != "" { toast-timer.running = true; }
    }

    app-focus := FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.modal-open { root.modal-action("close", ""); }
                root.player-options = false; root.app-menu = false;
                return accept;
            }
            if event.modifiers.control && (event.text == "k" || event.text == "K") && !root.modal-open && !root.command-open {
                root.command-open = true;
                root.command-query = "";
                root.action("command-query", "");
                return accept;
            }
            return reject;
        }
        key-pressed(event) => {
            if root.modal-open { return reject; }
            if root.view == "flow" {
                if event.text == Key.LeftArrow { root.flow-action("skip"); return accept; }
                if event.text == Key.RightArrow { root.flow-action("like"); return accept; }
                if event.text == " " { root.flow-action("play"); return accept; }
            } else if event.text == " " {
                root.player-action("toggle"); return accept;
            }
            return reject;
        }

        sidebar := Rectangle {
            x: 0px; y: 0px;
            width: root.side-width;
            height: parent.height;
            background: Theme.sidebar;
            accessible-role: navigation;
            accessible-label: I18n.side-label-nav;
            Image { x: 18px; y: 18px; width: 34px; height: 34px; source: @image-url("../resources/icon.png"); accessible-role: none; }
            SFText { x: 61px; y: 23px; height: 22px; width: parent.width - 68px; text: "SoundFlow"; font-size: 18px; font-weight: 700; }
            SFMuted { x: 19px; y: 80px; width: parent.width - 30px; height: 16px; text: I18n.side-library; font-size: 10px; font-weight: 600; }
            VerticalLayout {
                x: 10px; y: 103px; width: parent.width - 20px;
                height: 244px; spacing: 6px;
                SFButton { width: root.side-width - 20px; left-align: true; text: I18n.side-liked; label: I18n.playlist-likes; flat: true; checkable: true; active: root.view == "liked"; clicked => { root.navigate("liked"); } }
                SFButton { width: root.side-width - 20px; left-align: true; text: I18n.side-playlists; flat: true; checkable: true; active: root.view == "playlists" || root.view == "playlist"; clicked => { root.navigate("playlists"); } }
                SFButton { width: root.side-width - 20px; left-align: true; text: I18n.side-downloads; flat: true; checkable: true; active: root.view == "downloads"; clicked => { root.navigate("downloads"); } }
                SFButton { width: root.side-width - 20px; left-align: true; text: I18n.side-history; flat: true; checkable: true; active: root.view == "history"; clicked => { root.navigate("history"); } }
                SFButton { width: root.side-width - 20px; left-align: true; text: I18n.side-smart; flat: true; checkable: true; active: root.view == "smart"; clicked => { root.action("smart-playlist", root.smart-kind); } }
            }
            Rectangle { x: 18px; y: 365px; width: parent.width - 36px; height: 1px; background: Theme.line; }
            HorizontalLayout {
                x: 18px; y: 381px; width: parent.width - 30px; height: 34px;
                SFMuted { text: I18n.side-your-playlists; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                SFButton { text: "+"; label: I18n.side-create-playlist; icon: true; flat: true; width: 34px; height: 34px; clicked => { root.action("create-playlist", ""); } }
            }
            for playlist[index] in root.playlists : SFButton {
                visible: index < 3 && root.height > 640px;
                x: 10px; y: 423px + index * 40px;
                width: parent.width - 20px; height: 36px;
                text: playlist.name; label: (I18n.is-uk ? "Плейлист «" : "Playlist \"") + playlist.name + (I18n.is-uk ? "», " : "\", ") + playlist.count + " " + I18n.side-tracks-suffix;
                flat: true;
                clicked => { root.select-playlist(playlist.id); }
            }
            VerticalLayout {
                x: 10px; y: parent.height - 150px; width: parent.width - 20px;
                height: 86px; spacing: 6px;
                SFButton { width: root.side-width - 20px; left-align: true; text: I18n.side-connections; flat: true; checkable: true; active: root.view == "connections"; clicked => { root.navigate("connections"); } }
                SFButton { width: root.side-width - 20px; left-align: true; text: I18n.side-settings; flat: true; checkable: true; active: root.view == "settings"; clicked => { root.navigate("settings"); } }
            }
            Rectangle { x: 18px; y: parent.height - 53px; width: parent.width - 36px; height: 1px; background: Theme.line; }
            SFText { x: 18px; y: parent.height - 42px; width: parent.width - 36px; height: 18px; text: root.cloud-signed-in ? root.cloud-name : (root.profile-name != "" ? root.profile-name : I18n.profile-default); font-size: 13px; font-weight: 600; }
            SFMuted { x: 18px; y: parent.height - 23px; width: parent.width - 36px; height: 15px; text: root.cloud-signed-in ? "SoundFlow Account" : I18n.side-local-lib; font-size: 11px; }
        }

        navbar := Rectangle {
            x: root.side-width + (root.workspace-width - self.width) / 2;
            y: 13px;
            width: min(650px, root.workspace-width - 2 * root.content-inset);
            height: 53px;
            border-radius: 18px;
            background: Theme.surface;
            border-width: 1px; border-color: Theme.line;
            drop-shadow-blur: 17px; drop-shadow-offset-y: 4px; drop-shadow-color: #0000000e;
            accessible-role: navigation;
            accessible-label: I18n.side-label-main-nav;
            HorizontalLayout {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                padding: 6px; spacing: 3px;
                SFButton { text: I18n.nav-home; horizontal-stretch: 1; flat: true; checkable: true; active: root.view == "home"; clicked => { root.navigate("home"); } }
                SFButton { text: I18n.nav-search; horizontal-stretch: 1; flat: true; checkable: true; active: root.view == "search"; clicked => { root.navigate("search"); } }
                SFButton { text: "Flow"; horizontal-stretch: 1; flat: true; checkable: true; active: root.view == "flow"; clicked => { root.navigate("flow"); } }
                SFButton { text: I18n.nav-stats; horizontal-stretch: 1; flat: true; checkable: true; active: root.view == "stats"; clicked => { root.navigate("stats"); } }
                SFLangSwitch {
                    language: root.language;
                    language-changed(lang) => {
                        root.language = lang;
                        root.action("set-language", lang);
                    }
                }
                SFButton { width: 40px; text: "···"; icon: true; flat: true; label: I18n.nav-menu; clicked => { root.app-menu = !root.app-menu; } }
            }
        }

        content := Rectangle {
            x: root.side-width + root.content-inset;
            y: 84px;
            width: root.workspace-width - 2 * root.content-inset;
            height: parent.height - self.y - 108px;
            accessible-role: main;
            accessible-label: I18n.side-label-content;

            if root.view == "home" : HomeView {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                name: root.profile-name; compact: root.height < 780px;
                navigate(view) => { root.navigate(view); }
                discover(query) => { root.search(query, "all"); }
                flow(genre) => { root.flow-action("genre:" + genre); root.navigate("flow"); }
            }

            if root.view == "search" || root.view == "liked" || root.view == "playlist" || root.view == "history" || root.view == "smart" : Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                private property <length> list-top: root.view == "search" ? 150px : root.view == "smart" ? 128px : 97px;
                SFTitle { x: 0px; y: 0px; width: parent.width; height: 36px; text: root.view == "search" ? I18n.view-title-search : root.view == "liked" ? I18n.view-title-liked : root.view == "smart" ? I18n.smart-title : root.view == "history" ? I18n.view-title-history : I18n.view-title-playlist; }
                SFMuted { x: 0px; y: 40px; width: parent.width; height: 21px; text: root.view == "search" ? I18n.search-hint : root.tracks.length + " " + I18n.tracks-in-library; }
                if root.view == "smart" : HorizontalLayout {
                    x: 0px; y: 77px; width: parent.width; height: 40px; spacing: 6px;
                    SFButton { text: I18n.smart-recent; checkable: true; active: root.smart-kind == "recent"; clicked => { root.action("smart-playlist", "recent"); } }
                    SFButton { text: I18n.smart-top; checkable: true; active: root.smart-kind == "top"; clicked => { root.action("smart-playlist", "top"); } }
                    SFButton { text: I18n.smart-forgotten; checkable: true; active: root.smart-kind == "forgotten"; clicked => { root.action("smart-playlist", "forgotten"); } }
                }
                if root.view == "search" : HorizontalLayout {
                    x: 0px; y: 77px; width: parent.width; height: 43px; spacing: 8px;
                    SFField { horizontal-stretch: 1; text <=> root.search-query; label: I18n.search-field-label; placeholder: I18n.search-field-ph; input-type: InputType.search; focus-request: root.search-focus-request; accepted(query) => { root.search(query, root.search-source); } }
                    SFButton { text: I18n.search-btn-find; primary: true; enabled: !root.task-loading; clicked => { root.search(root.search-query, root.search-source); } }
                    SFButton { text: I18n.search-src-all; checkable: true; active: root.search-source == "all"; clicked => { root.search-source = "all"; root.search(root.search-query, "all"); } }
                    SFButton { text: "SC"; label: I18n.search-src-sc-label; checkable: true; active: root.search-source == "soundcloud"; clicked => { root.search-source = "soundcloud"; root.search(root.search-query, "soundcloud"); } }
                    SFButton { text: "YouTube"; checkable: true; active: root.search-source == "youtube"; clicked => { root.search-source = "youtube"; root.search(root.search-query, "youtube"); } }
                }
                if root.view == "playlist" : HorizontalLayout {
                    x: 0px; y: 58px; width: parent.width; height: 37px; spacing: 6px; alignment: start;
                    SFButton { text: I18n.playlist-play-all; primary: true; enabled: root.tracks.length > 0; clicked => { root.action("play-playlist", ""); } }
                    SFButton { text: I18n.playlist-download-all; enabled: root.tracks.length > 0 && !root.task-loading; clicked => { root.action("download-playlist", ""); } }
                    SFButton { text: I18n.playlist-rename; flat: true; clicked => { root.action("rename-playlist", ""); } }
                    SFButton { text: I18n.playlist-delete; flat: true; danger: true; clicked => { root.action("delete-playlist", ""); } }
                }
                ListView {
                    x: 0px; y: parent.list-top; width: parent.width; height: parent.height - self.y;
                    horizontal-scrollbar-policy: always-off;
                    for track in root.tracks : TrackItem {
                        track: track; current: track.id == root.current-track.id; removable: root.view == "playlist";
                        play(id) => { root.play-track(id); }
                        like(id) => { root.like-track(id); }
                        add(id) => { root.add-track(id); }
                        download(id) => { root.download-track(id); }
                        remove(id) => { root.action("remove-track", id); }
                    }
                }
                if root.view == "search" && root.tracks.length == 0 && root.search-history.length > 0 && !root.task-loading : SFPanel {
                    x: 0px; y: parent.list-top; width: parent.width; height: min(320px, parent.height - self.y);
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        HorizontalLayout {
                            height: 32px;
                            SFText { text: I18n.search-history-title; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                            SFButton { text: I18n.search-history-clear; flat: true; clicked => { root.action("clear-search-history", ""); } }
                        }
                        ListView {
                            for query[idx] in root.search-history : Rectangle {
                                height: 40px;
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px; spacing: 8px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        border-radius: 8px;
                                        background: item-touch.has-hover ? Theme.hover : transparent;
                                        SFText { x: 8px; width: parent.width - 16px; height: parent.height; text: "🔍  " + query; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                                        item-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.search-query = query;
                                                root.search(query, root.search-source);
                                            }
                                        }
                                    }
                                    SFButton {
                                        width: 32px; text: "×"; label: "Remove"; icon: true; flat: true;
                                        clicked => { root.action("remove-search-query", query); }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.task-loading && root.tracks.length == 0 : VerticalLayout {
                    x: 0px; y: parent.list-top; width: parent.width; height: min(parent.height - self.y, 408px);
                    spacing: 2px;
                    for index in 6 : SFSkeleton {
                        wide: Math.mod(index, 3) == 1;
                    }
                }
                if root.tracks.length == 0 && !root.task-loading && (root.view != "search" || root.search-history.length == 0) : SFPanel {
                    x: 0px; y: parent.list-top; width: parent.width; height: min(175px, parent.height - self.y);
                    VerticalLayout {
                        padding: 20px; spacing: 10px; alignment: center;
                        SFText { text: root.task-loading ? I18n.tracks-searching : root.view == "search" ? I18n.tracks-empty-search : I18n.tracks-empty-library; font-size: 17px; font-weight: 600; horizontal-alignment: center; }
                        SFMuted { text: root.view == "search" ? I18n.tracks-empty-search-sub : I18n.tracks-empty-library-sub; horizontal-alignment: center; wrap: word-wrap; }
                        if root.view != "search" : SFButton { text: I18n.tracks-find-music-btn; clicked => { root.navigate("search"); } }
                    }
                }
            }

            if root.view == "playlists" : Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                HorizontalLayout { x: 0px; y: 0px; width: parent.width; height: 44px; SFTitle { text: I18n.playlists-title; } SFButton { text: I18n.playlists-create-btn; primary: true; clicked => { root.action("create-playlist", ""); } } }
                SFMuted { x: 0px; y: 49px; width: parent.width; height: 21px; text: I18n.playlists-sub; }
                ListView {
                    x: 0px; y: 85px; width: parent.width; height: parent.height - self.y;
                    horizontal-scrollbar-policy: always-off;
                    for playlist in root.playlists : SFPanel {
                        preferred-height: 81px;
                        HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            SFCover { width: 52px; height: 52px; artwork: playlist.artwork; }
                            VerticalLayout { alignment: center; spacing: 4px; SFText { text: playlist.name; font-weight: 600; } SFMuted { text: playlist.count + " " + I18n.side-tracks-suffix; } }
                            SFButton { text: I18n.playlists-open-btn; clicked => { root.select-playlist(playlist.id); } }
                        }
                    }
                }
                if root.playlists.length == 0 : SFMuted { x: 0px; y: 102px; width: parent.width; text: I18n.playlists-empty; }
            }

            if root.view == "downloads" : Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                SFTitle { x: 0px; y: 0px; width: parent.width; height: 36px; text: I18n.dl-title; }
                SFMuted { x: 0px; y: 42px; width: parent.width; height: 38px; text: I18n.dl-sub; wrap: word-wrap; }
                HorizontalLayout {
                    x: 0px; y: 91px; width: parent.width; height: 44px; spacing: 9px;
                    SFField { text <=> root.download-url; label: I18n.dl-input-label; placeholder: I18n.dl-input-ph; accepted(url) => { root.action("download-url", url); } }
                    SFButton { text: I18n.dl-btn-download; primary: true; enabled: !root.task-loading && root.download-url != ""; clicked => { root.action("download-url", root.download-url); } }
                    SFButton { text: I18n.dl-btn-folder; flat: true; clicked => { root.action("open-downloads", ""); } }
                }
                ListView {
                    x: 0px; y: 159px; width: parent.width; height: parent.height - self.y;
                    horizontal-scrollbar-policy: always-off;
                    for job in root.downloads : SFPanel {
                        preferred-height: 97px;
                        HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            SFCover { width: 47px; height: 47px; artwork: job.artwork; }
                            VerticalLayout {
                                spacing: 4px;
                                SFText { text: job.title; font-weight: 600; }
                                SFMuted { text: job.status + "  ·  " + job.details; }
                                Rectangle {
                                    height: 4px; border-radius: 2px; background: Theme.line;
                                    accessible-role: progress-indicator; accessible-label: (I18n.is-uk ? "Завантаження «" : "Downloading \"") + job.title + (I18n.is-uk ? "»" : "\""); accessible-value: "" + job.progress; accessible-value-minimum: 0; accessible-value-maximum: 100;
                                    Rectangle { x: 0px; y: 0px; width: parent.width * min(1, max(0, job.progress / 100)); height: parent.height; border-radius: 2px; background: Theme.ink; }
                                }
                            }
                            if job.cancellable : SFButton { text: I18n.dl-btn-cancel; clicked => { root.action("cancel-download", job.id); } }
                        }
                    }
                }
                if root.downloads.length == 0 : SFMuted { x: 0px; y: 177px; width: parent.width; text: I18n.dl-empty-queue; wrap: word-wrap; }
            }

            if root.view == "flow" : Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                HorizontalLayout { x: 0px; y: 0px; width: parent.width; height: 38px; SFTitle { text: "Flow"; } SFButton { text: I18n.flow-refresh-btn; flat: true; clicked => { root.flow-action("refresh"); } } }
                SFMuted { x: 0px; y: 43px; width: parent.width; height: 22px; text: I18n.flow-hint; }
                HorizontalLayout {
                    x: 0px; y: 76px; width: parent.width; height: 40px; spacing: 5px;
                    SFButton { text: "Lo-fi"; checkable: true; active: root.flow-genre == "lofi"; clicked => { root.flow-action("genre:lofi"); } }
                    SFButton { text: "Deep house"; checkable: true; active: root.flow-genre == "deep"; clicked => { root.flow-action("genre:deep"); } }
                    SFButton { text: "Ambient"; checkable: true; active: root.flow-genre == "ambient"; clicked => { root.flow-action("genre:ambient"); } }
                    SFButton { text: "Synthwave"; checkable: true; active: root.flow-genre == "synthwave"; clicked => { root.flow-action("genre:synthwave"); } }
                    SFButton { text: I18n.flow-genre-ua; checkable: true; active: root.flow-genre == "ua"; clicked => { root.flow-action("genre:ua"); } }
                    SFButton { text: "Rock"; checkable: true; active: root.flow-genre == "rock"; clicked => { root.flow-action("genre:rock"); } }
                }
                SFPanel {
                    x: (parent.width - self.width) / 2; y: 137px;
                    width: min(650px, parent.width);
                    height: parent.height - self.y;
                    SwipeGestureHandler {
                        enabled: !root.modal-open && root.flow-track.id != "";
                        handle-swipe-left: true; handle-swipe-right: true;
                        swiped => {
                            if self.current-position.x > self.pressed-position.x + 50px { root.flow-action("like"); }
                            else if self.current-position.x < self.pressed-position.x - 50px { root.flow-action("skip"); }
                        }
                        HorizontalLayout {
                            padding: 20px; spacing: 25px;
                            SFCover { width: min(230px, parent.height - 40px); height: self.width; artwork: root.flow-track.artwork; }
                            VerticalLayout {
                                spacing: 10px; alignment: center;
                                SFMuted { text: root.flow-count > 0 ? I18n.flow-discovery-prefix + (root.flow-index + 1) + " / " + root.flow-count : I18n.flow-discovery-new; font-size: 11px; }
                                SFTitle { text: root.flow-track.id == "" ? (root.task-loading ? I18n.flow-searching : I18n.flow-start-mood) : root.flow-track.title; font-size: 23px; wrap: word-wrap; }
                                SFMuted { text: root.flow-track.artist; font-size: 15px; wrap: word-wrap; }
                                SFMuted { text: root.flow-track.id == "" ? I18n.flow-pick-genre : root.flow-track.source + I18n.flow-snippet-suffix; wrap: word-wrap; }
                                Rectangle { height: 4px; border-radius: 2px; background: Theme.line; Rectangle { x: 0px; y: 0px; width: parent.width * min(1, max(0, root.flow-progress)); height: parent.height; border-radius: 2px; background: Theme.ink; } }
                                HorizontalLayout {
                                    spacing: 6px; alignment: start;
                                    SFButton { text: "×"; label: I18n.flow-btn-skip-label; icon: true; enabled: root.flow-track.id != ""; clicked => { root.flow-action("skip"); } }
                                    SFButton { text: root.flow-playing ? "Ⅱ" : "▶"; label: root.flow-playing ? I18n.flow-btn-pause-label : I18n.flow-btn-play-label; primary: true; icon: true; enabled: root.flow-track.id != ""; clicked => { root.flow-action("play"); } }
                                    SFButton { text: "♡"; label: I18n.flow-btn-like-label; icon: true; enabled: root.flow-track.id != ""; clicked => { root.flow-action("like"); } }
                                    SFButton { text: "+"; label: I18n.flow-btn-save-label; icon: true; enabled: root.flow-track.id != ""; clicked => { root.flow-action("save"); } }
                                }
                                SFMuted { text: I18n.flow-shortcuts-hint; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }

            if root.view == "stats" : ScrollView {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                content-width: self.width; horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    padding-right: 10px; spacing: 18px;
                    SFTitle { text: I18n.stats-title; }
                    if !root.subscription-active : SFPanel {
                        preferred-height: 285px;
                        VerticalLayout {
                            padding: 27px; spacing: 14px; alignment: center;
                            SFMuted { text: "SOUNDFLOW PLUS"; font-size: 11px; font-weight: 600; }
                            SFTitle { text: I18n.stats-banner-title; font-size: 25px; wrap: word-wrap; }
                            SFMuted { text: I18n.stats-banner-desc; wrap: word-wrap; }
                            HorizontalLayout {
                                alignment: start; spacing: 9px;
                                SFButton { text: I18n.stats-btn-subscribe; primary: true; clicked => { root.action("open-subscription-modal", ""); } }
                                SFButton { text: I18n.stats-btn-promo; clicked => { root.action("open-promo-modal", ""); } }
                                SFButton { text: I18n.stats-btn-refresh; flat: true; clicked => { root.action("refresh-subscription", ""); } }
                            }
                            SFMuted { text: root.subscription-message != "" ? root.subscription-message : I18n.stats-all-accounts-hint; wrap: word-wrap; }
                        }
                    }
                    if root.subscription-active : VerticalLayout {
                        spacing: 17px;
                        SFPanel {
                            preferred-height: 54px;
                            HorizontalLayout {
                                padding-left: 18px; padding-right: 18px; alignment: center; spacing: 12px;
                                SFText { text: "⭐ SoundFlow Plus"; font-weight: 700; font-size: 15px; color: #f59e0b; }
                                SFMuted { text: root.subscription-message != "" ? root.subscription-message : I18n.stats-active; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                SFButton { text: I18n.stats-btn-manage; flat: true; clicked => { root.action("open-subscription-modal", ""); } }
                                SFButton { text: I18n.stats-btn-cancel; flat: true; danger: true; clicked => { root.action("cancel-subscription", ""); } }
                                SFButton { text: I18n.stats-btn-promo-short; flat: true; clicked => { root.action("open-promo-modal", ""); } }
                            }
                        }
                        HorizontalLayout {
                            height: 41px; spacing: 6px;
                            SFButton { text: I18n.stats-period-7d; checkable: true; active: root.stats-period == "7d"; clicked => { root.stats-period = "7d"; root.action("stats-period", "7d"); } }
                            SFButton { text: I18n.stats-period-30d; checkable: true; active: root.stats-period == "30d"; clicked => { root.stats-period = "30d"; root.action("stats-period", "30d"); } }
                            SFButton { text: I18n.stats-period-all; checkable: true; active: root.stats-period == "all"; clicked => { root.stats-period = "all"; root.action("stats-period", "all"); } }
                            SFButton { text: I18n.stats-import; flat: true; clicked => { root.action("import-listening", ""); } }
                        }
                        HorizontalLayout {
                            height: 39px; spacing: 5px;
                            SFButton { text: I18n.stats-source-all; checkable: true; active: root.stats-source == "all"; clicked => { root.stats-source = "all"; root.action("stats-source", "all"); } }
                            SFButton { text: "Spotify"; checkable: true; active: root.stats-source == "spotify"; clicked => { root.stats-source = "spotify"; root.action("stats-source", "spotify"); } }
                            SFButton { text: "SoundCloud"; checkable: true; active: root.stats-source == "soundcloud"; clicked => { root.stats-source = "soundcloud"; root.action("stats-source", "soundcloud"); } }
                            SFButton { text: "YouTube"; checkable: true; active: root.stats-source == "youtube"; clicked => { root.stats-source = "youtube"; root.action("stats-source", "youtube"); } }
                            SFButton { text: I18n.stats-source-local; checkable: true; active: root.stats-source == "local"; clicked => { root.stats-source = "local"; root.action("stats-source", "local"); } }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            for metric in root.metrics : SFPanel {
                                preferred-height: 100px;
                                VerticalLayout { padding: 16px; spacing: 5px; SFTitle { text: metric.value; font-size: 26px; } SFMuted { text: metric.label; } }
                            }
                        }
                        SFPanel {
                            min-height: 190px;
                            VerticalLayout {
                                padding: 18px; spacing: 12px;
                                SFText { height: 23px; text: I18n.stats-rhythm-title; font-size: 17px; font-weight: 600; }
                                HorizontalLayout {
                                    height: 110px; spacing: 4px;
                                    for day in root.daily : Rectangle {
                                        min-width: 3px;
                                        accessible-role: text;
                                        accessible-label: day.label + ": " + day.value;
                                        Rectangle { x: 0px; y: parent.height * (1 - min(1, max(0, day.level))); width: parent.width; height: max(2px, parent.height * min(1, max(0, day.level))); border-radius: min(4px, self.width / 2); background: Theme.ink; }
                                    }
                                }
                                if root.daily.length > 0 : HorizontalLayout {
                                    height: 16px;
                                    SFMuted { text: root.daily[0].label; font-size: 11px; }
                                    SFMuted { text: root.daily[root.daily.length - 1].label; font-size: 11px; horizontal-alignment: right; }
                                }
                                if root.daily.length == 0 : SFMuted { text: I18n.stats-empty; }
                            }
                        }
                        SFPanel {
                            VerticalLayout {
                                padding: 18px; spacing: 8px;
                                SFText { text: I18n.stats-top-artists; font-size: 17px; font-weight: 600; }
                                for artist[index] in root.artists : HorizontalLayout { height: 31px; SFMuted { width: 25px; text: "" + (index + 1); } SFText { text: artist.label; } SFMuted { text: artist.detail; horizontal-alignment: right; } }
                            }
                        }
                        SFPanel {
                            VerticalLayout {
                                padding: 18px; spacing: 8px;
                                SFText { text: I18n.stats-top-tracks; font-size: 17px; font-weight: 600; }
                                for track[index] in root.top-tracks : HorizontalLayout { height: 31px; SFMuted { width: 25px; text: "" + (index + 1); } SFText { text: track.label; } SFMuted { text: track.detail; horizontal-alignment: right; } }
                            }
                        }
                        SFPanel {
                            VerticalLayout {
                                padding: 18px; spacing: 8px;
                                SFText { text: I18n.stats-top-providers; font-size: 17px; font-weight: 600; }
                                for provider in root.providers : HorizontalLayout { height: 31px; SFText { text: provider.label; } SFMuted { text: provider.detail; horizontal-alignment: right; } }
                            }
                        }
                    }
                }
            }

            if root.view == "settings" : ScrollView {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                content-width: self.width; horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    padding-right: 10px; spacing: 18px;
                    SFTitle { text: I18n.set-title; }
                    SFPanel {
                        VerticalLayout {
                            padding: 20px; spacing: 14px;
                            SFText { text: I18n.set-appearance-title; font-size: 18px; font-weight: 600; }
                            HorizontalLayout {
                                SFText { text: I18n.set-language; vertical-alignment: center; }
                                SFButton { text: I18n.set-lang-uk; checkable: true; active: root.language != "en"; clicked => { root.language = "uk"; root.action("set-language", "uk"); } }
                                SFButton { text: I18n.set-lang-en; checkable: true; active: root.language == "en"; clicked => { root.language = "en"; root.action("set-language", "en"); } }
                            }
                            HorizontalLayout {
                                SFText { text: I18n.set-theme; vertical-alignment: center; }
                                SFButton { text: I18n.set-theme-light; checkable: true; active: !root.dark; clicked => { root.action("set-theme", "light"); } }
                                SFButton { text: I18n.set-theme-dark; checkable: true; active: root.dark; clicked => { root.action("set-theme", "dark"); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                SFText { text: I18n.set-accent; vertical-alignment: center; }
                                SFAccentDot { dot-color: Theme.palette-mono; selected: root.accent == "mono"; label: I18n.set-accent + " mono"; picked => { root.action("set-accent", "mono"); } }
                                SFAccentDot { dot-color: Theme.palette-blue; selected: root.accent == "blue"; label: I18n.set-accent + " blue"; picked => { root.action("set-accent", "blue"); } }
                                SFAccentDot { dot-color: Theme.palette-violet; selected: root.accent == "violet"; label: I18n.set-accent + " violet"; picked => { root.action("set-accent", "violet"); } }
                                SFAccentDot { dot-color: Theme.palette-rose; selected: root.accent == "rose"; label: I18n.set-accent + " rose"; picked => { root.action("set-accent", "rose"); } }
                                SFAccentDot { dot-color: Theme.palette-amber; selected: root.accent == "amber"; label: I18n.set-accent + " amber"; picked => { root.action("set-accent", "amber"); } }
                                SFAccentDot { dot-color: Theme.palette-green; selected: root.accent == "green"; label: I18n.set-accent + " green"; picked => { root.action("set-accent", "green"); } }
                            }
                            HorizontalLayout {
                                VerticalLayout { SFText { text: I18n.set-reduced-motion; } SFMuted { text: I18n.set-reduced-motion-desc; } }
                                SFButton { text: root.reduced-motion ? I18n.set-enabled : I18n.set-disabled; label: I18n.set-reduced-motion + ": " + (root.reduced-motion ? I18n.set-enabled : I18n.set-disabled); checkable: true; active: root.reduced-motion; clicked => { root.action("set-reduced-motion", root.reduced-motion ? "false" : "true"); } }
                            }
                            HorizontalLayout {
                                VerticalLayout { SFText { text: I18n.set-tray; } SFMuted { text: I18n.set-tray-desc; } }
                                SFButton { text: root.close-to-tray ? I18n.set-enabled : I18n.set-disabled; label: I18n.set-tray + ": " + (root.close-to-tray ? I18n.set-enabled : I18n.set-disabled); checkable: true; active: root.close-to-tray; clicked => { root.action("set-close-to-tray", root.close-to-tray ? "false" : "true"); } }
                            }
                            HorizontalLayout {
                                VerticalLayout { SFText { text: I18n.set-hotkeys; } SFMuted { text: I18n.set-hotkeys-desc; } }
                                SFButton { text: root.media-hotkeys ? I18n.set-enabled : I18n.set-disabled; label: I18n.set-hotkeys + ": " + (root.media-hotkeys ? I18n.set-enabled : I18n.set-disabled); checkable: true; active: root.media-hotkeys; clicked => { root.action("set-media-hotkeys", root.media-hotkeys ? "false" : "true"); } }
                            }
                            HorizontalLayout {
                                VerticalLayout { SFText { text: I18n.set-autoplay; } SFMuted { text: I18n.set-autoplay-desc; } }
                                SFButton { text: root.infinite-autoplay ? I18n.set-enabled : I18n.set-disabled; label: I18n.set-autoplay + ": " + (root.infinite-autoplay ? I18n.set-enabled : I18n.set-disabled); checkable: true; active: root.infinite-autoplay; clicked => { root.action("set-infinite-autoplay", root.infinite-autoplay ? "false" : "true"); } }
                            }
                            HorizontalLayout {
                                VerticalLayout { SFText { text: I18n.set-discord; } SFMuted { text: I18n.set-discord-desc; } }
                                SFButton { text: root.discord-rpc ? I18n.set-enabled : I18n.set-disabled; label: I18n.set-discord + ": " + (root.discord-rpc ? I18n.set-enabled : I18n.set-disabled); checkable: true; active: root.discord-rpc; clicked => { root.action("set-discord-rpc", root.discord-rpc ? "false" : "true"); } }
                            }
                            HorizontalLayout {
                                SFField { text <=> root.edited-name; label: I18n.set-name-label; placeholder: root.profile-name; accepted(name) => { root.action("update-profile", name); } }
                                SFButton { text: I18n.set-name-save; enabled: root.edited-name != ""; clicked => { root.action("update-profile", root.edited-name); } }
                            }
                        }
                    }
                    SFPanel {
                        VerticalLayout {
                            padding: 20px; spacing: 14px;
                            SFText { text: I18n.set-library-title; font-size: 18px; font-weight: 600; }
                            SFMuted { text: I18n.set-library-desc; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 7px;
                                SFButton { text: I18n.set-add-folder; clicked => { root.action("scan-local", ""); } }
                                SFButton { text: I18n.set-export; clicked => { root.action("export-library", ""); } }
                                SFButton { text: I18n.set-import; clicked => { root.action("import-library", ""); } }
                                SFButton { text: I18n.set-clear-history; danger: true; flat: true; clicked => { root.action("clear-history", ""); } }
                            }
                        }
                    }
                    SFPanel {
                        VerticalLayout {
                            padding: 20px; spacing: 14px;
                            SFText { text: I18n.set-account-header; font-size: 18px; font-weight: 600; }
                            SFMuted { text: I18n.set-account-desc; wrap: word-wrap; }
                            if root.cloud-signed-in : VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 12px; alignment: center;
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 3px;
                                        SFText { text: root.cloud-name != "" ? root.cloud-name : I18n.set-user-default; font-size: 17px; font-weight: 700; }
                                        SFMuted { text: root.cloud-email != "" ? root.cloud-email : I18n.set-local-account; font-size: 13px; }
                                        SFText { text: root.subscription-active ? "⭐ SoundFlow Plus (" + (root.subscription-message != "" ? root.subscription-message : I18n.stats-active) + ")" : I18n.set-free-plan; color: root.subscription-active ? #f59e0b : Theme.muted; font-size: 13px; font-weight: 600; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    SFButton { text: I18n.set-manage-plus; primary: !root.subscription-active; clicked => { root.action("open-subscription-modal", ""); } }
                                    if root.subscription-active : SFButton { text: I18n.set-cancel-plus; flat: true; danger: true; clicked => { root.action("cancel-subscription", ""); } }
                                    SFButton { text: I18n.set-promo; clicked => { root.action("open-promo-modal", ""); } }
                                    SFButton { text: I18n.set-connected-btn; clicked => { root.action("open-connected-accounts", ""); } }
                                    SFButton { text: I18n.set-switch-account-btn; clicked => { root.action("open-accounts-modal", ""); } }
                                    SFButton { text: I18n.set-sign-out; flat: true; danger: true; clicked => { root.sign-out(); } }
                                }
                                if root.cloud-configured || root.supabase-linked : HorizontalLayout {
                                    spacing: 8px;
                                    SFButton { text: I18n.set-sync-push; enabled: !root.task-loading; clicked => { root.sync-library("push"); } }
                                    SFButton { text: I18n.set-sync-pull; enabled: !root.task-loading; clicked => { root.sync-library("pull"); } }
                                }
                            }
                            if !root.cloud-signed-in : VerticalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    spacing: 3px;
                                    SFText { text: I18n.set-guest-profile; font-size: 17px; font-weight: 700; }
                                    SFMuted { text: I18n.set-guest-desc; wrap: word-wrap; }
                                    SFText { text: root.subscription-active ? "⭐ SoundFlow Plus (" + (root.subscription-message != "" ? root.subscription-message : I18n.stats-active) + ")" : I18n.set-free-plan; color: root.subscription-active ? #f59e0b : Theme.muted; font-size: 13px; font-weight: 600; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    SFButton { text: I18n.set-google-login; primary: true; enabled: !root.task-loading; clicked => { root.google-sign-in(); } }
                                    SFButton { text: "GitHub"; enabled: !root.task-loading; clicked => { root.github-sign-in(); } }
                                    SFButton { text: I18n.set-connected-btn; enabled: !root.task-loading; clicked => { root.action("open-connected-accounts", ""); } }
                                    SFButton { text: I18n.stats-btn-subscribe; clicked => { root.action("open-subscription-modal", ""); } }
                                    if root.subscription-active : SFButton { text: I18n.set-cancel-plus; flat: true; danger: true; clicked => { root.action("cancel-subscription", ""); } }
                                    SFButton { text: I18n.stats-btn-promo-short; flat: true; clicked => { root.action("open-promo-modal", ""); } }
                                    SFButton { text: I18n.set-accounts-btn; flat: true; clicked => { root.action("open-accounts-modal", ""); } }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            SFMuted { text: I18n.set-custom-server; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                SFField { text <=> root.server-url; label: I18n.set-server-url-label; placeholder: root.cloud-url != "" ? root.cloud-url : "https://soundflow.example"; accepted(url) => { root.configure-cloud(url); } }
                                SFButton { text: I18n.set-server-connect; enabled: root.server-url != "" && !root.task-loading; clicked => { root.configure-cloud(root.server-url); } }
                            }
                            if !root.cloud-signed-in && root.cloud-configured : VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 7px; alignment: start;
                                    SFButton { text: I18n.set-auth-signin; checkable: true; active: !root.register-mode; clicked => { root.register-mode = false; root.auth-password = ""; } }
                                    SFButton { text: I18n.set-auth-signup; checkable: true; active: root.register-mode; clicked => { root.register-mode = true; root.auth-password = ""; } }
                                }
                                if root.register-mode : SFField { text <=> root.auth-name; label: I18n.set-auth-name-label; placeholder: "Name"; }
                                SFField { text <=> root.auth-email; label: I18n.set-auth-email-label; placeholder: "email@example.com"; }
                                SFField { text <=> root.auth-password; label: I18n.set-auth-pass-label; placeholder: "••••••••"; input-type: password; accepted(password) => { if root.register-mode { root.sign-up(root.auth-name, root.auth-email, password); } else { root.sign-in(root.auth-email, password); } root.auth-password = ""; } }
                                SFButton { text: root.register-mode ? I18n.set-auth-submit-reg : I18n.set-auth-submit-login; primary: true; enabled: !root.task-loading && root.auth-email != "" && root.auth-password != ""; clicked => { if root.register-mode { root.sign-up(root.auth-name, root.auth-email, root.auth-password); } else { root.sign-in(root.auth-email, root.auth-password); } root.auth-password = ""; } }
                            }
                        }
                    }
                    SFPanel {
                        HorizontalLayout {
                            padding: 16px; spacing: 12px;
                            Image { width: 40px; height: 40px; source: @image-url("../resources/icon.png"); accessible-role: none; }
                            VerticalLayout { SFText { text: "SoundFlow"; font-weight: 600; } SFMuted { text: I18n.set-native-app-desc; } }
                            SFButton { text: I18n.set-about-btn; clicked => { root.action("about", ""); } }
                        }
                    }
                }
            }

            if root.view == "connections" : ScrollView {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                content-width: self.width; horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    padding-right: 10px; spacing: 18px;
                    SFTitle { text: I18n.conn-title; }
                    SFMuted { text: I18n.conn-desc; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 10px;
                        SFButton { text: I18n.conn-google-check; primary: true; clicked => { root.google-sign-in(); } }
                        SFButton { text: I18n.conn-manage; clicked => { root.action("open-connected-accounts", ""); } }
                    }
                    SFPanel {
                        preferred-height: 135px;
                        VerticalLayout {
                            padding: 18px; spacing: 10px;
                            HorizontalLayout { SFText { text: "Spotify"; font-size: 20px; font-weight: 600; } SFButton { text: I18n.conn-import-btn; clicked => { root.action("import-provider", "spotify"); } } }
                            SFMuted { text: I18n.is-uk ? "Імпорт плейлиста за посиланням. Для відтворення й завантаження обирається запис у SoundCloud або YouTube." : "Import playlists by link. Playback and downloads match via SoundCloud or YouTube."; wrap: word-wrap; }
                        }
                    }
                    SFPanel {
                        preferred-height: 135px;
                        VerticalLayout {
                            padding: 18px; spacing: 10px;
                            HorizontalLayout { SFText { text: "SoundCloud"; font-size: 20px; font-weight: 600; } SFButton { text: I18n.conn-import-btn; clicked => { root.action("import-provider", "soundcloud"); } } }
                            SFMuted { text: I18n.is-uk ? "Пісні та плейлисти за посиланням або профілем." : "Tracks and playlists by link or profile."; wrap: word-wrap; }
                        }
                    }
                    SFPanel {
                        preferred-height: 135px;
                        VerticalLayout {
                            padding: 18px; spacing: 10px;
                            HorizontalLayout { SFText { text: "YouTube"; font-size: 20px; font-weight: 600; } SFButton { text: I18n.conn-import-btn; clicked => { root.action("import-provider", "youtube"); } } }
                            SFMuted { text: I18n.is-uk ? "Відео, музика та плейлисти за посиланням." : "Music, videos, and playlists by link."; wrap: word-wrap; }
                        }
                    }
                }
            }
        }

        player := Rectangle {
            x: root.side-width + (root.workspace-width - self.width) / 2;
            y: parent.height - 93px;
            width: min(980px, root.workspace-width - 2 * root.content-inset);
            height: 78px;
            border-radius: 20px;
            background: Theme.surface;
            border-width: 1px; border-color: Theme.line;
            drop-shadow-blur: 22px; drop-shadow-offset-y: 3px; drop-shadow-color: #00000012;
            accessible-role: region;
            accessible-label: I18n.player-region-label;
            private property <bool> track-fading: false;
            // М'який градієнт кольору поточної обкладинки.
            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                border-radius: parent.border-radius;
                background: root.player-accent;
                animate background { duration: Theme.reduced-motion ? 0ms : 320ms; }
            }
            Timer {
                interval: 150ms;
                running: player.track-fading;
                triggered => { player.track-fading = false; }
            }
            HorizontalLayout {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                padding-left: 14px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; spacing: 8px;
                SFCover {
                    width: 47px; height: 47px; artwork: root.current-track.artwork;
                    opacity: player.track-fading ? 0.25 : 1;
                    animate opacity { duration: Theme.reduced-motion ? 0ms : 150ms; }
                }
                VerticalLayout {
                    width: min(206px, root.workspace-width * 0.22); alignment: center; spacing: 3px;
                    opacity: player.track-fading ? 0.25 : 1;
                    animate opacity { duration: Theme.reduced-motion ? 0ms : 150ms; }
                    SFText { text: root.current-track.id == "" ? I18n.player-pick-song : root.current-track.title; font-size: 13px; font-weight: 600; }
                    SFMuted { text: root.loading ? I18n.player-buffering : root.current-track.id == "" ? I18n.player-start-here : root.current-track.artist; font-size: 12px; }
                }
                SFButton { text: root.current-track.liked ? "♥" : "♡"; label: root.current-track.liked ? I18n.player-fav-remove : I18n.player-fav-add; checkable: true; checked: root.current-track.liked; accent: root.current-track.liked; icon: true; flat: true; enabled: root.current-track.id != ""; clicked => { root.like-track(root.current-track.id); } }
                SFButton { text: "‹"; label: I18n.player-prev; icon: true; flat: true; enabled: root.current-track.id != ""; clicked => { root.player-action("previous"); } }
                SFButton { text: root.playing ? "Ⅱ" : "▶"; label: root.playing ? I18n.player-pause : I18n.player-play; accent: true; icon: true; enabled: root.current-track.id != ""; clicked => { root.player-action("toggle"); } }
                SFButton { text: "›"; label: I18n.player-next; icon: true; flat: true; enabled: root.current-track.id != ""; clicked => { root.player-action("next"); } }
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 60px; spacing: 0px; alignment: center;
                    SFSlider { value: root.position; maximum: root.duration; step: 5; label: I18n.player-pos-label; enabled: root.current-track.id != ""; released(value) => { root.seek(value); } changed(value) => { if !self.enabled { return; } } }
                    HorizontalLayout {
                        height: 16px;
                        SFMuted { text: Math.floor(root.position / 60) + ":" + (mod(Math.floor(root.position), 60) < 10 ? "0" : "") + mod(Math.floor(root.position), 60); font-size: 10px; }
                        SFMuted { text: Math.floor(root.duration / 60) + ":" + (mod(Math.floor(root.duration), 60) < 10 ? "0" : "") + mod(Math.floor(root.duration), 60); font-size: 10px; horizontal-alignment: right; }
                    }
                }
                if root.width >= 1200px : SFSlider { width: 72px; label: I18n.player-volume; value: root.volume; maximum: 1; step: 0.05; changed(value) => { root.set-volume(value); } released(value) => { root.set-volume(value); } }
                SFButton { text: "···"; label: I18n.player-options-label; icon: true; flat: true; clicked => { root.player-options = !root.player-options; } }
            }
        }

        if root.player-options : SFPanel {
            x: player.x + player.width - self.width;
            y: root.height - 249px; width: 260px; height: 146px;
            drop-shadow-blur: 20px; drop-shadow-color: #00000018;
            VerticalLayout {
                padding: 13px; spacing: 8px;
                HorizontalLayout { SFMuted { width: 61px; text: I18n.player-volume; vertical-alignment: center; } SFSlider { value: root.volume; maximum: 1; step: 0.05; label: I18n.player-volume; changed(value) => { root.set-volume(value); } released(value) => { root.set-volume(value); } } }
                HorizontalLayout { spacing: 7px; SFButton { text: I18n.player-shuffle; checkable: true; active: root.shuffle; clicked => { root.player-action("shuffle"); } } SFButton { text: root.repeat-mode == "one" ? I18n.player-repeat-one : I18n.player-repeat; checkable: true; active: root.repeat-mode != "off"; clicked => { root.player-action("repeat"); } } }
                SFButton { text: I18n.player-queue-title; flat: true; clicked => { root.player-action("queue"); root.player-options = false; } }
            }
        }

        if root.app-menu : SFPanel {
            x: navbar.x + navbar.width - self.width; y: 74px; width: 220px; height: root.update-url != "" ? 227px : 190px;
            drop-shadow-blur: 20px; drop-shadow-color: #00000018;
            VerticalLayout {
                padding: 8px; spacing: 5px;
                SFButton {
                    text: root.language == "en" ? "Українська мова (UA)" : "English language (EN)";
                    flat: true;
                    clicked => {
                        if root.language == "en" {
                            root.language = "uk";
                            root.action("set-language", "uk");
                        } else {
                            root.language = "en";
                            root.action("set-language", "en");
                        }
                        root.app-menu = false;
                    }
                }
                if root.update-url != "" : SFButton {
                    text: I18n.update-available + " " + root.update-version;
                    flat: true;
                    clicked => { root.action("open-release", root.update-url); root.app-menu = false; }
                }
                SFButton {
                    text: I18n.command-menu + "   Ctrl+K";
                    flat: true;
                    clicked => {
                        root.app-menu = false;
                        root.command-open = true;
                        root.command-query = "";
                        root.action("command-query", "");
                    }
                }
                SFButton { text: I18n.nav-settings; flat: true; clicked => { root.navigate("settings"); root.app-menu = false; } }
                SFButton { text: I18n.set-about-btn; flat: true; clicked => { root.action("about", ""); root.app-menu = false; } }
            }
        }
        if root.message != "" : SFPanel {
            x: root.side-width + (root.workspace-width - self.width) / 2;
            y: root.height - 155px; width: min(650px, root.workspace-width - 48px); height: 50px;
            accessible-role: region; accessible-label: "Message"; accessible-live-region: polite;
            HorizontalLayout { padding-left: 14px; padding-right: 6px; spacing: 8px; SFText { text: root.message; font-size: 13px; vertical-alignment: center; color: root.message-error ? Theme.danger : Theme.ink; } SFButton { text: "×"; label: "Close message"; icon: true; flat: true; clicked => { root.action("dismiss-message", ""); } } }
        }
    }

    if root.modal-open : FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { if !root.modal-busy { root.modal-action("close", ""); } return accept; }
            return reject;
        }
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height; background: #00000055;
            TouchArea { clicked => { if !root.modal-busy { root.modal-action("close", ""); } } }
        }
        SFPanel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(root.modal-kind == "connected-accounts" || root.modal-kind == "subscription-plans" || root.modal-kind == "accounts-list" ? 820px : 650px, parent.width - 40px);
            height: min(root.modal-kind == "import-prompt" ? 440px : root.modal-kind == "connected-accounts" ? 440px : root.modal-kind == "subscription-plans" ? 555px : root.modal-kind == "accounts-list" ? 470px : root.modal-kind == "match" || root.modal-kind == "queue" || root.modal-kind == "add-to-playlist" ? 490px : root.modal-kind == "about" ? 430px : root.modal-kind == "promo-code" ? 330px : 310px, parent.height - 50px);
            drop-shadow-blur: 30px; drop-shadow-color: #00000025;
            accessible-role: region; accessible-label: root.modal-title;
            TouchArea { }
            FocusScope { width: 0px; height: 0px; changed has-focus => { if self.has-focus { dialog-cancel.focus(); } } }
            VerticalLayout {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                padding: 24px; spacing: 13px;
                HorizontalLayout { height: 40px; SFTitle { text: root.modal-title; font-size: 22px; } dialog-close := SFButton { text: "×"; label: "Close dialog"; icon: true; flat: true; modal-control: true; enabled: !root.modal-busy; init => { self.focus(); } clicked => { root.modal-action("close", ""); } } }
                SFMuted { text: root.modal-description; wrap: word-wrap; }
                if root.modal-kind == "connected-accounts" : VerticalLayout {
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 12px;
                        SFPanel {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 14px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    Rectangle { width: 14px; height: 14px; border-radius: 4px; background: #FF0000; }
                                    SFText { text: "YouTube / YouTube Music"; font-size: 15px; font-weight: 700; }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    SFText {
                                        text: root.yt-found ? I18n.acc-found : I18n.acc-not-found;
                                        color: root.yt-found ? #22c55e : Theme.muted;
                                        font-weight: 600; font-size: 13px;
                                    }
                                    SFMuted {
                                        text: root.yt-found && root.yt-account != "" ? root.yt-account : I18n.yt-sub-label;
                                        font-size: 12px;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    SFButton {
                                        text: root.yt-found ? I18n.acc-change : I18n.acc-login;
                                        modal-control: true;
                                        clicked => { root.connect-account("youtube", root.yt-account); }
                                    }
                                    SFButton {
                                        text: I18n.acc-import-tracks;
                                        primary: root.yt-found;
                                        enabled: root.yt-found && !root.modal-busy;
                                        modal-control: true;
                                        clicked => { root.import-account("youtube"); }
                                    }
                                }
                            }
                        }
                        SFPanel {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 14px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    Rectangle { width: 14px; height: 14px; border-radius: 4px; background: #FF5500; }
                                    SFText { text: "SoundCloud"; font-size: 15px; font-weight: 700; }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    SFText {
                                        text: root.sc-found ? I18n.acc-found : I18n.acc-not-found;
                                        color: root.sc-found ? #22c55e : Theme.muted;
                                        font-weight: 600; font-size: 13px;
                                    }
                                    SFMuted {
                                        text: root.sc-found && root.sc-account != "" ? root.sc-account : I18n.sc-sub-label;
                                        font-size: 12px;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    SFButton {
                                        text: root.sc-found ? I18n.acc-change : I18n.acc-login;
                                        modal-control: true;
                                        clicked => { root.connect-account("soundcloud", root.sc-account); }
                                    }
                                    SFButton {
                                        text: I18n.acc-import-tracks;
                                        primary: root.sc-found;
                                        enabled: root.sc-found && !root.modal-busy;
                                        modal-control: true;
                                        clicked => { root.import-account("soundcloud"); }
                                    }
                                }
                            }
                        }
                        SFPanel {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 14px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    Rectangle { width: 14px; height: 14px; border-radius: 4px; background: #1DB954; }
                                    SFText { text: "Spotify"; font-size: 15px; font-weight: 700; }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    SFText {
                                        text: root.sp-found ? I18n.acc-found : I18n.acc-not-found;
                                        color: root.sp-found ? #22c55e : Theme.muted;
                                        font-weight: 600; font-size: 13px;
                                    }
                                    SFMuted {
                                        text: root.sp-found && root.sp-account != "" ? root.sp-account : I18n.sp-sub-label;
                                        font-size: 12px;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    SFButton {
                                        text: root.sp-found ? I18n.acc-change : I18n.acc-login;
                                        modal-control: true;
                                        clicked => { root.connect-account("spotify", root.sp-account); }
                                    }
                                    SFButton {
                                        text: I18n.acc-import-tracks;
                                        primary: root.sp-found;
                                        enabled: root.sp-found && !root.modal-busy;
                                        modal-control: true;
                                        clicked => { root.import-account("spotify"); }
                                    }
                                }
                            }
                        }
                    }
                    if root.accounts-import-status != "" : SFText {
                        text: root.accounts-import-status;
                        color: #22c55e;
                        font-weight: 600;
                        font-size: 13px;
                    }
                }
                if root.modal-kind == "import-prompt" : VerticalLayout {
                    spacing: 9px;
                    if root.yt-found : HorizontalLayout {
                        spacing: 10px; alignment: center;
                        Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #FF0000; }
                        SFText { text: "YouTube Music" + (root.yt-account != "" ? "  ·  " + root.yt-account : ""); font-size: 14px; }
                    }
                    if root.sc-found : HorizontalLayout {
                        spacing: 10px; alignment: center;
                        Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #FF5500; }
                        SFText { text: "SoundCloud" + (root.sc-account != "" ? "  ·  " + root.sc-account : ""); font-size: 14px; }
                    }
                    if root.sp-found : HorizontalLayout {
                        spacing: 10px; alignment: center;
                        Rectangle { width: 10px; height: 10px; border-radius: 5px; background: #1DB954; }
                        SFText { text: "Spotify" + (root.sp-account != "" ? "  ·  " + root.sp-account : ""); font-size: 14px; }
                    }
                    Rectangle {
                        height: 24px; background: transparent;
                        HorizontalLayout {
                            spacing: 8px;
                            SFText {
                                text: root.import-prompt-disabled ? "☑" : "☐";
                                font-size: 16px;
                                vertical-alignment: center;
                                color: root.import-prompt-disabled ? Theme.ink : Theme.control-line;
                            }
                            SFMuted { text: I18n.acc-import-never; font-size: 12px; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.import-prompt-disabled = !root.import-prompt-disabled; } }
                    }
                    SFMuted { text: I18n.acc-import-prompt-hint; font-size: 12px; wrap: word-wrap; }
                }
                if root.modal-kind == "about" : VerticalLayout {
                    spacing: 15px;
                    HorizontalLayout { spacing: 14px; Image { width: 64px; height: 64px; source: @image-url("../resources/icon.png"); accessible-role: none; } VerticalLayout { SFTitle { text: "SoundFlow"; font-size: 24px; } SFMuted { text: I18n.about-subtitle; } } }
                    SFMuted { text: I18n.about-version + " " + root.app-version + (root.update-version != "" ? "  ·  " + I18n.update-available + " " + root.update-version : ""); font-size: 12px; }
                    SFMuted { text: I18n.about-hotkeys; wrap: word-wrap; }
                    AboutSlint { }
                }
                if root.modal-kind == "match" : ListView {
                    horizontal-scrollbar-policy: always-off;
                    for track in root.match-tracks : TrackItem {
                        track: track; modal-control: true;
                        play(id) => { root.modal-action("select-match", id); }
                        like(id) => { root.like-track(id); }
                        add(id) => { root.add-track(id); }
                        download(id) => { root.modal-action("download-match", id); }
                    }
                }
                if root.modal-kind == "queue" : ListView {
                    horizontal-scrollbar-policy: always-off;
                    for track in root.match-tracks : SFButton { text: track.title + " · " + track.artist; left-align: true; horizontal-stretch: 1; modal-control: true; clicked => { root.modal-action("play-queue", track.id); } }
                }
                if root.modal-kind == "add-to-playlist" : ListView {
                    horizontal-scrollbar-policy: always-off;
                    for playlist in root.playlists : SFButton { text: playlist.name + "  ·  " + playlist.count + " " + I18n.side-tracks-suffix; modal-control: true; clicked => { root.modal-action("select-playlist", playlist.id); } }
                }
                if root.modal-kind == "subscription-plans" : VerticalLayout {
                    spacing: 16px;
                    SFPanel {
                        preferred-height: 48px;
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px; alignment: center; spacing: 12px;
                            SFText { text: root.subscription-active ? I18n.sub-active-banner : (I18n.set-free-plan + ":"); font-size: 13px; font-weight: 700; color: root.subscription-active ? #f59e0b : Theme.muted; }
                            SFMuted { text: root.subscription-active ? (root.subscription-message != "" ? root.subscription-message : "SoundFlow Plus") : "SoundFlow Free"; font-size: 13px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            SFButton {
                                text: I18n.sub-opt-out;
                                flat: true;
                                danger: true;
                                modal-control: true;
                                clicked => { root.action("cancel-subscription", ""); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        SFPanel {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 18px; spacing: 10px; alignment: space-between;
                                VerticalLayout {
                                    spacing: 4px;
                                    SFText { text: I18n.sub-plan-1m; font-size: 16px; font-weight: 700; }
                                    SFTitle { text: I18n.sub-price-1m; font-size: 28px; }
                                    SFMuted { text: I18n.sub-period-1m; font-size: 12px; }
                                }
                                SFMuted { text: I18n.sub-desc-1m; font-size: 11px; wrap: word-wrap; }
                                SFButton { text: I18n.sub-btn-1m; modal-control: true; clicked => { root.action("buy-plan", "month"); } }
                            }
                        }
                        SFPanel {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 18px; spacing: 10px; alignment: space-between;
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        SFText { text: I18n.sub-plan-1y; font-size: 16px; font-weight: 700; }
                                        Rectangle { horizontal-stretch: 1; }
                                        SFText { text: "-17%"; font-size: 12px; font-weight: 700; color: #22c55e; }
                                    }
                                    SFTitle { text: I18n.sub-price-1y; font-size: 28px; }
                                    SFMuted { text: I18n.sub-period-1y; font-size: 12px; }
                                }
                                SFMuted { text: I18n.sub-desc-1y; font-size: 11px; wrap: word-wrap; }
                                SFButton { text: I18n.sub-btn-1y; primary: true; modal-control: true; clicked => { root.action("buy-plan", "year"); } }
                            }
                        }
                        SFPanel {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 18px; spacing: 10px; alignment: space-between;
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        SFText { text: I18n.sub-plan-lifetime; font-size: 16px; font-weight: 700; color: #f59e0b; }
                                        Rectangle { horizontal-stretch: 1; }
                                        SFText { text: "VIP"; font-size: 12px; font-weight: 700; color: #f59e0b; }
                                    }
                                    SFTitle { text: I18n.sub-price-lifetime; font-size: 28px; }
                                    SFMuted { text: I18n.sub-period-lifetime; font-size: 12px; }
                                }
                                SFMuted { text: I18n.sub-desc-lifetime; font-size: 11px; wrap: word-wrap; }
                                SFButton { text: I18n.sub-btn-lifetime; modal-control: true; clicked => { root.action("buy-plan", "lifetime"); } }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: center; spacing: 12px;
                        SFButton { text: I18n.sub-btn-promo; flat: true; modal-control: true; clicked => { root.action("open-promo-modal", ""); } }
                        SFButton { text: I18n.sub-btn-vip; flat: true; modal-control: true; clicked => { root.action("grant-subscription", "VIP"); } }
                        SFButton {
                            text: I18n.sub-btn-cancel;
                            flat: true;
                            danger: true;
                            modal-control: true;
                            clicked => { root.action("cancel-subscription", ""); }
                        }
                    }
                }
                if root.modal-kind == "promo-code" : VerticalLayout {
                    spacing: 14px;
                    SFField {
                        text <=> root.modal-value;
                        label: I18n.promo-modal-label;
                        placeholder: I18n.promo-modal-ph;
                        modal-control: true;
                        accepted(val) => { root.action("apply-promo", val); }
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: end;
                        SFButton { text: I18n.promo-modal-vip-btn; modal-control: true; clicked => { root.action("grant-subscription", "VIP"); } }
                        SFButton { text: I18n.promo-modal-btn; primary: true; modal-control: true; enabled: root.modal-value != ""; clicked => { root.action("apply-promo", root.modal-value); } }
                    }
                }
                if root.modal-kind == "accounts-list" : VerticalLayout {
                    spacing: 12px;
                    ListView {
                        horizontal-scrollbar-policy: always-off;
                        for acc in root.accounts : HorizontalLayout {
                            height: 48px; spacing: 12px;
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 1; spacing: 2px;
                                SFText { text: acc.name + (acc.is-active ? I18n.accounts-active-tag : ""); font-weight: 600; font-size: 14px; }
                                SFMuted { text: acc.email + " · " + (acc.is-plus ? "⭐ SoundFlow Plus (" + acc.expires-formatted + ")" : I18n.accounts-free-tag); font-size: 12px; }
                            }
                            if !acc.is-active : SFButton { text: I18n.accounts-switch-btn; modal-control: true; clicked => { root.action("switch-account-id", acc.id); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: end;
                        SFButton { text: I18n.accounts-new-btn; modal-control: true; clicked => { root.action("open-create-account-modal", ""); } }
                        SFButton { text: I18n.set-google-login; primary: true; modal-control: true; clicked => { root.google-sign-in(); } }
                    }
                }
                if root.modal-kind != "about" && root.modal-kind != "match" && root.modal-kind != "queue" && root.modal-kind != "add-to-playlist" && root.modal-kind != "confirm" && root.modal-kind != "connected-accounts" && root.modal-kind != "import-prompt" && root.modal-kind != "subscription-plans" && root.modal-kind != "promo-code" && root.modal-kind != "accounts-list" : SFField {
                    text <=> root.modal-value; label: root.modal-title; placeholder: I18n.modal-enter-value-ph; modal-control: true; enabled: !root.modal-busy;
                    accepted(value) => { root.modal-submit(value); }
                }
                if root.modal-error != "" : SFText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    if root.modal-kind == "connected-accounts" : SFButton {
                        text: I18n.accounts-import-all;
                        primary: true;
                        modal-control: true;
                        enabled: !root.modal-busy && (root.yt-found || root.sc-found || root.sp-found);
                        clicked => { root.import-all-accounts(""); }
                    }
                    if root.modal-kind == "import-prompt" : SFButton {
                        text: I18n.acc-import-now;
                        primary: true;
                        modal-control: true;
                        enabled: !root.modal-busy;
                        clicked => { root.import-all-accounts((root.yt-found ? "youtube," : "") + (root.sc-found ? "soundcloud," : "") + (root.sp-found ? "spotify," : "")); }
                    }
                    dialog-cancel := SFButton { text: root.modal-kind == "import-prompt" ? I18n.acc-import-later : root.modal-kind == "connected-accounts" ? I18n.acc-confirm-btn : root.modal-kind == "about" || root.modal-kind == "subscription-plans" || root.modal-kind == "accounts-list" ? I18n.modal-done : I18n.modal-cancel; modal-control: true; enabled: !root.modal-busy; clicked => { root.modal-action("close", ""); } }
                    if root.modal-kind != "about" && root.modal-kind != "match" && root.modal-kind != "queue" && root.modal-kind != "add-to-playlist" && root.modal-kind != "connected-accounts" && root.modal-kind != "import-prompt" && root.modal-kind != "subscription-plans" && root.modal-kind != "promo-code" && root.modal-kind != "accounts-list" : SFButton { text: root.modal-busy ? I18n.modal-wait : root.modal-kind == "confirm" ? I18n.modal-confirm : I18n.modal-save; primary: true; modal-control: true; enabled: !root.modal-busy; clicked => { root.modal-submit(root.modal-value); } }
                    if root.modal-kind == "add-to-playlist" : SFButton { text: I18n.modal-create-playlist-btn; primary: true; modal-control: true; clicked => { root.modal-action("create-playlist", ""); } }
                }
            }
            FocusScope { width: 0px; height: 0px; changed has-focus => { if self.has-focus { dialog-close.focus(); } } }
        }
    }

    if root.command-open : FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.command-open = false; return accept; }
            return reject;
        }
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            background: #00000055;
            TouchArea { clicked => { root.command-open = false; } }
        }
        SFPanel {
            x: (parent.width - self.width) / 2; y: 110px;
            width: min(560px, parent.width - 80px);
            height: min(430px, parent.height - 190px);
            drop-shadow-blur: 30px; drop-shadow-color: #00000033;
            VerticalLayout {
                padding: 14px; spacing: 10px;
                SFField {
                    height: 42px;
                    text <=> root.command-query;
                    label: I18n.command-placeholder;
                    placeholder: I18n.command-placeholder;
                    input-type: InputType.search;
                    edited(value) => { root.action("command-query", value); }
                    accepted(_) => { root.action("run-command", root.commands.length > 0 ? root.commands[0].id : ""); }
                }
                if root.commands.length == 0 : SFMuted { text: I18n.command-empty; }
                ListView {
                    horizontal-scrollbar-policy: always-off;
                    for command in root.commands : SFButton {
                        text: command.title + (command.hint != "" ? "   ·   " + command.hint : "");
                        left-align: true;
                        horizontal-stretch: 1;
                        flat: true;
                        clicked => { root.action("run-command", command.id); }
                    }
                }
            }
        }
    }

    if root.show-onboarding : FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.action("complete-onboarding", "");
                root.show-onboarding = false;
                return accept;
            }
            return reject;
        }
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height; background: #00000077;
            TouchArea { clicked => { root.action("complete-onboarding", ""); root.show-onboarding = false; } }
        }
        SFPanel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(580px, parent.width - 32px);
            height: min(520px, parent.height - 32px);
            drop-shadow-blur: 36px; drop-shadow-color: #00000035;
            accessible-role: region; accessible-label: I18n.welcome-title;
            TouchArea { }
            VerticalLayout {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                padding: 28px; spacing: 14px; alignment: space-between;

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 12px; alignment: center;
                        Rectangle {
                            width: 44px; height: 44px; border-radius: 14px;
                            background: Theme.ink;
                            Image {
                                width: 28px; height: 28px;
                                source: @image-url("../resources/icon.png");
                                image-fit: contain;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px; alignment: center;
                            SFTitle { text: I18n.welcome-title; font-size: 20px; font-weight: 800; }
                            SFMuted { text: "SoundFlow Music Player"; font-size: 12px; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: center;
                        SFLangSwitch {
                            modal-control: true;
                            language: root.language;
                            language-changed(lang) => {
                                root.language = lang;
                                root.action("set-language", lang);
                            }
                        }
                        SFButton {
                            text: "×";
                            flat: true;
                            icon: true;
                            modal-control: true;
                            label: "Close";
                            clicked => {
                                root.action("complete-onboarding", "");
                                root.show-onboarding = false;
                            }
                        }
                    }
                }

                SFMuted {
                    text: I18n.welcome-subtitle;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                SFPanel {
                    preferred-height: 110px;
                    VerticalLayout {
                        padding: 12px; spacing: 8px; alignment: center;
                        SFText { text: I18n.welcome-feat-streams; font-size: 12px; }
                        SFText { text: I18n.welcome-feat-offline; font-size: 12px; }
                        SFText { text: I18n.welcome-feat-stats; font-size: 12px; }
                    }
                }

                VerticalLayout {
                    spacing: 10px;
                    SFButton {
                        text: "G   " + I18n.welcome-google-btn;
                        primary: true;
                        modal-control: true;
                        clicked => {
                            root.google-sign-in();
                            root.action("complete-onboarding", "");
                            root.show-onboarding = false;
                        }
                    }
                    SFButton {
                        text: "⚡   " + I18n.welcome-github-btn;
                        modal-control: true;
                        clicked => {
                            root.github-sign-in();
                            root.action("complete-onboarding", "");
                            root.show-onboarding = false;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: center; spacing: 8px;
                    Rectangle { height: 1px; horizontal-stretch: 1; background: Theme.line; y: 10px; }
                    SFMuted { text: I18n.welcome-or; font-size: 12px; }
                    Rectangle { height: 1px; horizontal-stretch: 1; background: Theme.line; y: 10px; }
                }

                HorizontalLayout {
                    alignment: center;
                    SFButton {
                        text: I18n.welcome-guest-btn + "  →";
                        flat: true;
                        modal-control: true;
                        clicked => {
                            root.action("complete-onboarding", "");
                            root.show-onboarding = false;
                        }
                    }
                }
            }
        }
    }
}
