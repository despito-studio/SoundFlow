    out property <string> sub-modal-title: is-uk ? "Підписка SoundFlow Plus ⭐" : "SoundFlow Plus Subscription ⭐";
    out property <string> sub-modal-manage-title: is-uk ? "Керування підпискою SoundFlow Plus ⭐" : "Manage SoundFlow Plus ⭐";
    out property <string> sub-modal-desc: is-uk ? "Отримай повний доступ до детальної статистики прослуховування, ритму та топів:" : "Get full access to detailed listening statistics, rhythm, and top charts:";
    out property <string> sub-modal-manage-desc: is-uk ? "Ваша підписка активна. Ви можете змінити тарифний план або скасувати підписку:" : "Your subscription is active. You can change your plan or opt out:";
    out property <string> sub-plan-1m: is-uk ? "1 Місяць" : "1 Month";
    out property <string> sub-plan-1y: is-uk ? "1 Рік" : "1 Year";
    out property <string> sub-plan-lifetime: is-uk ? "Назавжди ⭐" : "Lifetime ⭐";
    out property <string> sub-price-1m: "$1";
    out property <string> sub-price-1y: "$10";
    out property <string> sub-price-lifetime: "$25";
    out property <string> sub-period-1m: is-uk ? "на місяць" : "per month";
    out property <string> sub-period-1y: is-uk ? "на рік ($0.83/міс)" : "per year ($0.83/mo)";
    out property <string> sub-period-lifetime: is-uk ? "разовий платіж" : "one-time payment";
    out property <string> sub-desc-1m: is-uk ? "Повний доступ до аналітики прослуховування та топів." : "Full access to listening analytics and charts.";
    out property <string> sub-desc-1y: is-uk ? "12 місяців Plus за вигідною ціною з усіма оновленнями." : "12 months of Plus at the best price with all updates.";
    out property <string> sub-desc-lifetime: is-uk ? "Довічний доступ назавжди без регулярних списань." : "Lifetime access forever with zero recurring charges.";
    out property <string> sub-btn-1m: is-uk ? "Обрати $1/міс" : "Select $1/mo";
    out property <string> sub-btn-1y: is-uk ? "Обрати $10/рік" : "Select $10/yr";
    out property <string> sub-btn-lifetime: is-uk ? "Назавжди ⭐" : "Get Lifetime ⭐";
    out property <string> sub-btn-promo: is-uk ? "Ввести промокод" : "Enter Promo Code";
    out property <string> sub-btn-vip: is-uk ? "Видати Plus безкоштовно (VIP)" : "Grant Plus for Free (VIP)";
    out property <string> sub-btn-cancel: is-uk ? "Скасувати підписку" : "Cancel Subscription";
    out property <string> sub-active-banner: is-uk ? "⭐ Підписка активна:" : "⭐ Subscription active:";
    out property <string> sub-opt-out: is-uk ? "Відмовитися від підписки" : "Opt out of subscription";

    // Promo Modal
    out property <string> promo-modal-title: is-uk ? "Активація промокоду SoundFlow Plus" : "Activate SoundFlow Plus Promo Code";
    out property <string> promo-modal-desc: is-uk ? "Введи промокод (наприклад: PLUS, VIP, SOUNDFLOW, FREE) або отримай Plus безкоштовно:" : "Enter promo code (e.g. PLUS, VIP, SOUNDFLOW, FREE) or activate Plus for free:";
    out property <string> promo-modal-label: is-uk ? "Промокод" : "Promo Code";
    out property <string> promo-modal-ph: is-uk ? "Наприклад: PLUS, VIP, SOUNDFLOW, FREE" : "e.g. PLUS, VIP, SOUNDFLOW, FREE";
    out property <string> promo-modal-vip-btn: is-uk ? "Видати Plus (VIP Free)" : "Grant Plus (VIP Free)";
    out property <string> promo-modal-btn: is-uk ? "Активувати код" : "Activate Code";

    // Confirmation Modal
    out property <string> confirm-cancel-sub-title: is-uk ? "Скасувати підписку SoundFlow Plus?" : "Cancel SoundFlow Plus Subscription?";
    out property <string> confirm-cancel-sub-desc: is-uk ? "Ви впевнені, що хочете відмовитися від підписки SoundFlow Plus? Доступ до розширеної аналітики та персональної статистики буде вимкнено." : "Are you sure you want to cancel your SoundFlow Plus subscription? Access to advanced analytics and personal statistics will be disabled.";

    // Connected Accounts
    out property <string> accounts-connected-title: is-uk ? "Підключені музичні акаунти (Google Cloud + Supabase)" : "Connected Music Accounts (Google Cloud + Supabase)";
    out property <string> accounts-import-all: is-uk ? "Імпортувати все знайдене" : "Import All Found";
    out property <string> acc-confirm-btn: is-uk ? "Підтвердити акаунти" : "Confirm Accounts";
    out property <string> acc-found: is-uk ? "✓ Знайдено" : "✓ Found";
    out property <string> acc-not-found: is-uk ? "✕ Не знайдено" : "✕ Not found";
    out property <string> yt-sub-label: is-uk ? "Канал або плейлист" : "Channel or playlist";
    out property <string> sc-sub-label: is-uk ? "Вподобані та плейлисти" : "Likes and playlists";
    out property <string> sp-sub-label: is-uk ? "Плейлист або альбом" : "Playlist or album";
    out property <string> acc-change: is-uk ? "Змінити акаунт" : "Change Account";
    out property <string> acc-login: is-uk ? "Підключити окремо" : "Connect Separately";
    out property <string> acc-import-tracks: is-uk ? "Імпортувати треки" : "Import Tracks";
    out property <string> acc-import-prompt-hint: is-uk ? "Пізніше це можна змінити в Налаштуваннях → Підключені акаунти." : "You can change this later in Settings → Connected accounts.";
    out property <string> acc-import-now: is-uk ? "Імпортувати" : "Import";
    out property <string> acc-import-later: is-uk ? "Не зараз" : "Not now";
    out property <string> acc-import-never: is-uk ? "Більше не питати" : "Don't ask again";
    out property <string> update-available: is-uk ? "Доступне оновлення" : "Update available";
    out property <string> about-version: is-uk ? "Версія" : "Version";

    // Accounts List
    out property <string> accounts-list-title: is-uk ? "Керування акаунтами SoundFlow" : "SoundFlow Accounts Management";
    out property <string> accounts-list-desc: is-uk ? "Обери акаунт для перемикання або додай новий:" : "Choose an account to switch or add a new one:";
    out property <string> accounts-active-tag: is-uk ? "  (Активний)" : "  (Active)";
    out property <string> accounts-switch-btn: is-uk ? "Увійти" : "Switch";
    out property <string> accounts-free-tag: is-uk ? "Безкоштовний" : "Free";
    out property <string> accounts-new-btn: is-uk ? "+ Новий акаунт" : "+ New Account";

    // About
    out property <string> about-subtitle: is-uk ? "Нативний музичний застосунок · Rust" : "Native Music Application · Rust";
    out property <string> about-hotkeys: is-uk ? "Клавіші: Ctrl+K — пошук, Пробіл — відтворення, Esc — закрити діалог. У Flow: ← пропустити, → вподобати." : "Shortcuts: Ctrl+K — search, Space — play/pause, Esc — close dialog. In Flow: ← skip, → like.";

    // Welcome / Onboarding Modal
    out property <string> welcome-title: is-uk ? "Ласкаво просимо до SoundFlow" : "Welcome to SoundFlow";
    out property <string> welcome-subtitle: is-uk ? "Твій швидкий та нативний музичний плеєр. Увійди, щоб синхронізувати медіатеку, або продовж без акаунта:" : "Your fast & native music player. Sign in to sync your library or continue without an account:";
    out property <string> welcome-google-btn: is-uk ? "Увійти через Google" : "Continue with Google";
    out property <string> welcome-github-btn: is-uk ? "Увійти через GitHub" : "Continue with GitHub";
    out property <string> welcome-guest-btn: is-uk ? "Продовжити як гість" : "Continue as Guest";
    out property <string> welcome-lang-label: is-uk ? "Мова / Language:" : "Language / Мова:";
    out property <string> welcome-feat-streams: is-uk ? "• Необмежений стримінг YouTube, SoundCloud та Spotify" : "• Unlimited streaming from YouTube, SoundCloud & Spotify";
    out property <string> welcome-feat-offline: is-uk ? "• Завантаження треків офлайн та підтримка локальних аудіофайлів" : "• Offline audio downloads & local library playback";
    out property <string> welcome-feat-stats: is-uk ? "• Рекомендації Flow, тексти пісень та детальна аналітика" : "• Personalized Flow recommendations, lyrics & detailed stats";
    out property <string> welcome-or: is-uk ? "або" : "or";

    // GitHub Auth Modal
    out property <string> github-modal-title: is-uk ? "Вхід через GitHub" : "Sign in with GitHub";
    out property <string> github-modal-desc: is-uk ? "Введи свій GitHub username або email для входу в SoundFlow:" : "Enter your GitHub username or email to sign in to SoundFlow:";
    out property <string> github-modal-ph: is-uk ? "GitHub username або email" : "GitHub username or email";
}

