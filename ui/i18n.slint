// SoundFlow Internationalization (i18n) Module
// Supports instant reactive runtime language switching (Ukrainian & English).

export global I18n {
    in-out property <string> locale: "uk";
    out property <bool> is-uk: locale != "en";

    // Navigation & Sidebar
    out property <string> nav-home: is-uk ? "Головна" : "Home";
    out property <string> nav-search: is-uk ? "Пошук" : "Search";
    out property <string> nav-flow: is-uk ? "Flow" : "Flow";
    out property <string> nav-stats: is-uk ? "Статистика" : "Stats";
